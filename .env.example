# Copy to .env (or .env.local) and fill in. All VITE_* values are embedded in the
# public JavaScript bundle at build time - never put secrets here.

# Google Apps Script web app URL (ends in /exec). Required for submissions.
VITE_SCRIPT_URL=

# Prize text shown on the registration page ("Stand a chance to win ...").
VITE_PRIZE_NAME=a wireless mouse

# Optional secondary button on the home screen.
VITE_LEARN_MORE_URL=
VITE_LEARN_MORE_LABEL=Learn more

# Comma-separated background video playlist, served from public/.
VITE_BACKGROUND_VIDEOS=/videos/promo-1.mp4,/videos/promo-2.mp4,/videos/promo-3.mp4

# Seconds before returning to the home screen after a successful submission.
VITE_REDIRECT_SECONDS=5

# NOTE: the volunteer code is NOT configured here. Set it as the VOLUNTEER_CODE
# Script Property in the Apps Script project so it never reaches the browser.
